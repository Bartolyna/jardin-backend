# Configuración de Django - AMBIENTE LOCAL
DEBUG=True
SECRET_KEY=jardin-tricahue-local-secret-key-2024-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,jardin_web_local

# Configuración de la base de datos LOCAL (PostgreSQL en Docker)
DB_NAME=jardin_db_local
DB_USER=jardin_user
DB_PASSWORD=jardin*12345
DB_HOST=db
DB_PORT=5432

# Configuración de CORS LOCAL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Configuración de zona horaria (Chile)
TZ=America/Santiago
TIME_ZONE=America/Santiago
LANGUAGE_CODE=es-cl

# Configuración de logs
DJANGO_LOG_LEVEL=INFO