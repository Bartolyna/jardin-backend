# Configuración de Django - AMBIENTE LOCAL
DEBUG=True
SECRET_KEY=local-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de la base de datos LOCAL
DB_NAME=jardin_db_local
DB_USER=jardin_user
DB_PASSWORD=jardin*12345
DB_HOST=db
DB_PORT=5432

# Configuración de CORS LOCAL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Configuración de zona horaria
TZ=America/Bogota
TIME_ZONE=America/Bogota

# Configuración de logs
DJANGO_LOG_LEVEL=INFO