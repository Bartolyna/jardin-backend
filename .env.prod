# Configuración de Django - AMBIENTE PRODUCCIÓN
DEBUG=False
SECRET_KEY=your-production-secret-key-here-change-this
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,www.your-domain.com

# Configuración de la base de datos PRODUCCIÓN
DB_NAME=jardin_db
DB_USER=jardin_user
DB_PASSWORD=jardin*12345
DB_HOST=db
DB_PORT=5432

# Configuración de CORS PRODUCCIÓN
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Configuración de zona horaria
TZ=America/Bogota
TIME_ZONE=America/Bogota

# Configuración de logs PRODUCCIÓN
DJANGO_LOG_LEVEL=WARNING

# Configuración de SSL (para certificados)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Configuración de email (para notificaciones)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password